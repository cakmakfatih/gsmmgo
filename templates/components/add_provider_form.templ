package templates

import "echochat/models"

templ AddProviderForm(panels []models.PanelModel, formID string, services []models.ServiceModel) {
    <form onkeydown="return event.key != 'Enter';" hx-swap="none" class="min-h-0 flex flex-1 flex-col px-6 py-4 min-h-0" x-data="{ panel: '', form: $el }">
        <label for="panel" class="font-semibold px-3 py-1 text-sm">Panel (*)</label>
        <select x-model="panel" id="panel" name="panel" class="transition-colors block px-2 py-2 text-gray-900 border border-gray-300 rounded-lg bg-gray-100 focus:bg-white text-sm focus:border-gray-500 outline-none">
            for _, panel := range panels {
                <option value={panel.ID}>{ panel.LoginURL }</option>
            }
        </select>
        @ProviderFormBody(models.ProviderModel{}, formID, services)
        { children... }
    </form>
}
