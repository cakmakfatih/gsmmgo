package templates

import (
    "echochat/models"
    "fmt"
)

templ AddServiceFromProviderForm(provider models.ProviderModel, id string, services []models.ServiceModel) {
    <header class="px-2 flex justify-between items-center text-green-600">
        if id == "addServiceFromNewlyAddedProviderForm" {
            <h1 class="text-xl">Newly Added Provider:</h1>
            <span target="_blank" href={provider.URL} class="text-sm text-blue-600 hover:underline-offset-1 cursor:pointer">{ provider.URL }</span>
        } else {
            <h1 class="text-xl">Services</h1>
        }
    </header>
    <h2 class="px-2 text-sm">Add or edit a service for the provider</h2>
    <div class="mt-2 p-2 border mb-2 flex flex-row self-stretch items-center">
        <input name="provider" type="hidden" value={provider.ID} />
        <input name="serviceId" type="text" class="p-2 w-28 max-w-28 mr-2 text-sm border-b outline-none border-gray-300 focus:border-gray-600" placeholder="Service ID" />
        <input name="serviceName" type="text" class="p-2 w-36 mr-2 max-w-36 text-ellipsis text-sm border-b outline-none border-gray-300 focus:border-gray-600" placeholder="Service Name" />
        <input name="refillDuration" type="text" class="p-2 w-36 max-w-28 text-sm border-b outline-none border-gray-300 focus:border-gray-600" placeholder="Refill Duration" />
        if id != "addServiceFromNewlyAddedProviderForm" {
            <input name="from" type="hidden" value="edit" />
        }
        <div class="flex-1"></div>
        <button type="button" hx-post="/partials/providers/services" class="text-gray-600 bg-white border border-gray-500 items-center p-2 rounded-lg font-semibold hover:bg-gray-100 active:bg-gray-200 transition-colors duration-150 text-sm px-3">Add</button>
    </div>
    <div id={id} class="pb-3 pt-1 flex flex-1 flex-col overflow-y-scroll min-h-0 divider-solid divide-y">
        for _, service := range services {
            <form class="flex service" hx-disinherit="*">
                <input type="hidden" name="editProviderID" value={provider.ID} />
                <input name="editServiceID" class="p-2 w-28 max-w-28 mr-2 text-sm border-b outline-none border-gray-300 focus:border-gray-600" value={fmt.Sprint(service.ServiceID)} placeholder="Service ID" @click="$el.select()" />
                <input name="editServiceName" class="text-xs flex-1 p-2 mr-2 max-w-[50%] text-ellipsis text-sm border-b outline-none border-gray-300 focus:border-gray-600" value={service.Name} placeholder="Service Name" @click="$el.select()" />
                if !service.HasRefill {
                    <input type="text" class="p-2 w-28 max-w-28 text-sm border-b outline-none border-gray-300 focus:border-gray-600" name="editRefillDuration" value="NoRefill" @click="$el.select()" />
                } else {
                    <input type="text" class="p-2 w-28 max-w-28 text-sm border-b outline-none border-gray-300 focus:border-gray-600" name="editRefillDuration" value={fmt.Sprint(service.RefillDuration)} @click="$el.select()" />
                }
                <button type="button" hx-swap="none" hx-patch={`/partials/providers/services/` + service.ID} @click="$nextTick(() => { $dispatch('toggle-notification'); setTimeout(() => { $dispatch('toggle-notification'); }, 3500); })" class="mr-3 text-gray-600 bg-white border border-gray-500 items-center p-2 rounded-lg font-semibold hover:bg-gray-100 active:bg-gray-200 transition-colors duration-150 text-sm px-3">Edit</button>
            </form>
        }
    </div>
}
