package templates

templ MainContent() {
    <content id="pageView" class="flex flex-col flex-1 min-h-0">
        { children... }
    </content>
    <div id="addRecordModal" class="transition-all fixed h-dvh w-0 right-0 top-0 bg-white z-10 border-r"></div>
    <div id="overlay" _="on click add .hidden to me then remove .w-35p from <div#addRecordModal /> then remove .opacity-100 from me" class="hidden transition-opacity opacity-0 bg-black/[0.34] absolute left-0 top-0 h-full w-full z-5"></div>
}
